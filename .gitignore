# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
deploymenterror.txt

# env files (do not commit .env.local!)
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# drizzle
drizzle/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Claude Desktop
.claude/

# Claude Code agent files
.agent/

# Temporary and error files
deploymenterrors.txt
*.log
*.tmp

# Large CSV data files (used for seeding only)
docs/*.csv
docs/

# Backup files
*.bak
*.backup
deploymenterror.txt

# manually added cause NTFS attaches this sometimes when copying to WSL
*:Zone.Identifier

# Campaign assets (local only)
/campaigns/

# Screenshots (often have long names)
Screenshot*.png
*.screenshot.png

# manually added snyk security reports
*snyk*
# Sentry Config File
.env.sentry-build-plugin
