# Supabase Postgres Database URL (pooled connection)
# Get from Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# Use the "Transaction pooler" connection string for serverless
POSTGRES_URL="postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require"
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"
SUPABASE_STORAGE_BUCKET="talk-thumbnails"

# Public base URL for the application
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# YouTube Data API v3 Key
# Used for fetching video metadata (duration, year, thumbnails)
# See docs/YOUTUBE-API-SETUP.md for setup instructions
YOUTUBE_API_KEY="your_youtube_api_key_here"

# Admin Portal Protection
# Set this to a secure random token to protect the /admin routes
# Generate with: openssl rand -base64 32
ADMIN_TOKEN="your_secure_admin_token_here"

# Bluesky Authentication (for Signal Deck mention scanning)
# Required for searching posts that mention tarottalks.app
# Create an App Password at: https://bsky.app/settings/app-passwords
BLUESKY_IDENTIFIER="tarottalks.bsky.social"
BLUESKY_APP_PASSWORD="your_app_password_here"

# Google Gemini API (Free Tier - for AI spread readings)
# Get your API key at: https://makersuite.google.com/app/apikey
# Free tier: 15 requests/min, 1M tokens/min
GOOGLE_GEMINI_API_KEY="your_gemini_api_key_here"

# manually added after setting up bsky API cron event for social metrics
CRON_SECRET="cron_secret_here"